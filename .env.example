# Environment Configuration
# Copy this file to .env for local development
# NEVER commit real production secrets to version control.

# Application Environment: development, staging, production
ENVIRONMENT=development
APP_NAME=CycloneGuard
APP_VERSION=0.1.0-sprint1
DEBUG=true

# Database Settings
# For local dev / testing fallback: sqlite:///./cycloneguard.db
# For PostgreSQL: postgresql+psycopg2://cyclone_user:cyclone_password@localhost:5432/cycloneguard_db
DATABASE_URL=sqlite:///./cycloneguard.db
DB_ECHO=false

# Security & JWT Authentication
# IMPORTANT: Generate a strong random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=dev-cycloneguard-insecure-secret-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & CORS Configuration
# Comma-separated list of allowed origins. Do NOT allow '*' in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Backend Server Host/Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Initial Admin Seeding (Used strictly by scripts/seed_dev.py in development)
DEV_ADMIN_NAME=Admin Officer
DEV_ADMIN_EMAIL=admin@cycloneguard.internal
DEV_ADMIN_PASSWORD=CycloneGuard2026!Admin
